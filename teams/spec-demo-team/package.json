{
  "name": "spec-demo-team",
  "private": true,
  "type": "module",
  "workspaces": ["packages/api", "packages/web", "infra"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tdd:check": "node scripts/tdd-check.mjs",
    "build": "npm run build -w packages/web",
    "synth": "npm run build && npm run synth -w infra",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
